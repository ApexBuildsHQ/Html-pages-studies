<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Suez University - Musculoskeletal Physiology Exam (Answer Key - Text Only)</title>
    <style>
        :root {
            --primary-color: #0d47a1;
            --secondary-color: #1565c0;
            --accent-color: #2e7d32; /* اللون الأخضر للإجابة الصحيحة */
            --bg-color: #f5f7fa;
            --card-bg: #ffffff;
            --text-color: #212121;
            --border-color: #cfd8dc;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 20px 0;
        }

        /* Print & Page Layout Configuration */
        .page {
            background-color: var(--card-bg);
            width: 210mm;
            min-height: 297mm;
            margin: 0 auto 30px auto;
            padding: 25mm 20mm 20mm 20mm;
            position: relative;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            display: flex;
            flex-direction: column;
        }

        @media print {
            body {
                background-color: #ffffff;
                padding: 0;
            }
            .page {
                margin: 0;
                box-shadow: none;
                page-break-after: always;
            }
        }

        /* Header Styling */
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
            border-bottom: 3px solid var(--primary-color);
        }

        .header-logo-cell {
            width: 15%;
            text-align: left;
            padding-bottom: 10px;
        }

        .header-logo-circle {
            width: 60px;
            height: 60px;
            border: 3px solid var(--primary-color);
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            color: var(--primary-color);
            font-size: 1.4rem;
        }

        .header-title-cell {
            width: 70%;
            text-align: center;
            padding-bottom: 10px;
        }

        .header-title-cell h1 {
            font-size: 1.5rem;
            color: var(--primary-color);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .header-title-cell p {
            font-size: 0.95rem;
            color: #555;
            font-weight: 500;
        }

        .header-info-cell {
            width: 15%;
            text-align: right;
            font-size: 0.85rem;
            color: #666;
            padding-bottom: 10px;
            font-weight: 500;
        }

        /* Content & Questions */
        .content {
            flex-grow: 1;
        }

        .question-block {
            margin-bottom: 18px;
            page-break-inside: avoid;
        }

        .question-text {
            font-size: 1rem;
            font-weight: 600;
            color: #1a237e;
            margin-bottom: 8px;
            display: flex;
        }

        .question-number {
            margin-right: 8px;
            color: var(--primary-color);
        }

        .options-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            padding-left: 25px;
        }

        .option {
            padding: 4px 0;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            position: relative;
            color: var(--text-color);
        }

        /* التعديل الجديد: تلوين النص فقط بدون خلفيات أو مستطيلات */
        .option.correct-option {
            color: var(--accent-color) !important;
            font-weight: bold;
        }

        .option-letter {
            font-weight: bold;
            color: #555;
            margin-right: 8px;
        }

        .option.correct-option .option-letter {
            color: var(--accent-color);
        }

        /* Footer & Key Banners */
        .footer-banner {
            margin-top: 20px;
            border-top: 1px solid var(--border-color);
            padding-top: 15px;
        }

        .key-banner {
            background-color: #e3f2fd;
            border: 1px dashed var(--secondary-color);
            border-radius: 6px;
            padding: 10px;
            text-align: center;
            font-size: 0.85rem;
            font-weight: bold;
            color: #0d47a1;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .footer-info {
            display: flex;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #78909c;
            font-weight: 500;
        }
    </style>
</head>
